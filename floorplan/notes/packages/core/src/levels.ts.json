    },
    {
      "id": "n8",
      "symbol": "BATCH_MAX",
      "line": 40,
      "offset": 0,
      "text": "Most jobs Sparky runs side by side, whatever the PC.",
      "kind": "doc"
    },
    {
      "id": "n9",
      "symbol": "batchConcurrency",
      "line": 42,
      "offset": 0,
      "text": "How many jobs run at the same time. Off means one at a time.\nLow keeps the PC quiet, so one. Normal already gives each job half the processor, so two fill it.\nMax takes everything, so about half the processor's threads, between two and four: extra jobs mostly\nhelp when the graphics card does the heavy part or when downloads and documents sit beside a video.",
      "kind": "doc"
    },
    {
      "id": "n10",
      "symbol": "CompressionInfo.hint",
      "line": 56,
      "offset": 0,
      "text": "Friendly hint shown under the slider.",
      "kind": "doc"
    },
    {
      "id": "n11",
      "symbol": "CompressionInfo.crf",
      "line": 57,
      "offset": 0,
      "text": "x264/x265-style quality number (lower is better).",
      "kind": "doc"
    },
    {
      "id": "n12",
      "symbol": "CompressionInfo.imageQuality",
      "line": 59,
